ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://rankverse:rankverse@localhost:5432/rankverse
# Optional, for scripts/import_tmdb_catalog.py: Supabase's transaction-mode pooler
# (same as DATABASE_URL but port 6543). See app/core/database.py.
BULK_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

TMDB_API_KEY=your-tmdb-api-key-here
TMDB_BASE_URL=https://api.themoviedb.org/3

# scripts/translate_overviews.py only
ANTHROPIC_API_KEY=your-anthropic-api-key-here

INTERNAL_API_KEY=change-this-to-a-random-internal-key

RANKING_MIN_VOTES=50
RANKING_USER_WEIGHT=0.7
RANKING_EXTERNAL_WEIGHT=0.3
