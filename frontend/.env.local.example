NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Must match the backend's JWT_SECRET exactly (see .env.example at repo root) —
# middleware.ts verifies the admin session cookie locally, without a
# round-trip to the backend, so it needs the same signing key.
ADMIN_JWT_SECRET=change-this-to-the-same-value-as-backend-JWT_SECRET

# Optional cookie-less analytics (see components/Analytics.tsx). Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
