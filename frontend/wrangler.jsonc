{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankverse-frontend",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rankverse-frontend"
    }
  ],
  // NOTE: this only sets a runtime binding (env.NEXT_PUBLIC_API_BASE_URL) inside the
  // Worker. NEXT_PUBLIC_* values used via process.env.* in the app code are inlined at
  // `next build` time from .env.production instead (see frontend/.env.production) —
  // update both if this value ever changes.
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://rankverse-production.up.railway.app/api/v1"
  },
  "observability": {
    "enabled": true
  },
  // Raised for the OG image route (frontend/app/lists/[slug]/opengraph-image.tsx),
  // which does font shaping + PNG rasterization via Satori/resvg -- CPU-heavy enough
  // to trip the platform default and return a 1102 "Worker exceeded resource limits"
  // error. 30000 is the max Workers allows (actual ceiling still depends on plan).
  "limits": {
    "cpu_ms": 30000
  }
}
