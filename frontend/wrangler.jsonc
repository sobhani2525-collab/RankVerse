{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankverse-frontend",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // ISR/fetch cache store for OpenNext (open-next.config.ts).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "d37ed7aa4a3c4c61b2117ca35097f90a"
    }
  ],
  // Lets the Worker call itself to regenerate stale ISR pages in the background.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rankverse-frontend"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://cinemagozin.liara.run/api/v1"
  }
}
