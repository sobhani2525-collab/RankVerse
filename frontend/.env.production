NEXT_PUBLIC_API_BASE_URL=https://cinemagozinbk.ir/api/v1
# TMDb is unreachable from Liara, and Iranian networks throttle Cloudflare's IPs:
# posters load from our own /tmdb-img route (app/tmdb-img, cached on the Liara
# app, filled from the Cloudflare mirror), with that mirror as the fallback.
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://cinemagozin.ir/tmdb-img
NEXT_PUBLIC_TMDB_IMAGE_FALLBACK_BASE=https://img.cinemagozin.ir
